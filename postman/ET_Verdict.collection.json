{
  "info": {
    "_postman_id": "7a3c1f4e-8b2d-4f6a-9c1e-0d5b7a9e2f4c",
    "name": "ET_Verdict — MiniFeed API",
    "description": "API test suite for the MiniFeed social feed. Set base_url=http://localhost:8000 and api_prefix= (empty) for local mode, or base_url=http://localhost and api_prefix=/api for Docker mode. Run 'Auth → POST /auth/login' first: its test script saves the JWT into the {{token}} variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/health",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('response time < 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "pm.test('health body has status healthy', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('status', 'healthy');",
                  "    pm.expect(json).to.have.property('database', 'ok');",
                  "    pm.expect(json).to.have.property('cache', 'ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/signup",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_user\",\n  \"email\": \"postman_user@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/signup",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "auth", "signup"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('response time < 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "pm.test('user object has required fields', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id').that.is.a('number');",
                  "    pm.expect(json).to.have.property('username', 'postman_user');",
                  "    pm.expect(json).to.have.property('email', 'postman_user@example.com');",
                  "    pm.expect(json).to.have.property('created_at');",
                  "    pm.expect(json).to.not.have.property('hashed_password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"postman_user@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('response time < 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "pm.test('login returns an access token', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('access_token');",
                  "    pm.expect(json.access_token).to.match(/^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/);",
                  "    pm.expect(json).to.have.property('token_type', 'bearer');",
                  "});",
                  "pm.test('store access token in environment', function () {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('token', json.access_token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "GET /posts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/posts",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "posts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('response time < 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "pm.test('feed is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "pm.test('every post carries content and an author', function () {",
                  "    const posts = pm.response.json();",
                  "    if (posts.length === 0) { pm.expect(posts.length).to.equal(0); return; }",
                  "    posts.forEach(function (post) {",
                  "        pm.expect(post).to.have.property('id');",
                  "        pm.expect(post).to.have.property('content').that.is.a('string');",
                  "        pm.expect(post).to.have.property('author').that.has.property('username');",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /posts",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello from Postman!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/posts",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "posts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('response time < 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "pm.test('created post has required fields', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id').that.is.a('number');",
                  "    pm.expect(json).to.have.property('content', 'Hello from Postman!');",
                  "    pm.expect(json).to.have.property('created_at');",
                  "    pm.expect(json).to.have.property('author').that.has.property('username');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": []
}
